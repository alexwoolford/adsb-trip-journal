# Installed at /opt/adsb-trip-journal/etc/adsb-trip-journal.env
# Copied by deploy/install.sh if missing. Fill OpenSky credentials on the host (chmod 600).
# Never commit a populated copy. install.sh does not overwrite this file once it exists.

RUST_LOG=info
ADSB_TRIP_JOURNAL_BIN=/opt/adsb-trip-journal/bin/adsb-trip-journal

TAIL_TO_TICKER_SQLITE=/var/lib/tail-to-ticker/current/tail_to_ticker.sqlite
TRIP_JOURNAL_DATA=/var/lib/adsb-trip-journal
TRIP_JOURNAL_CACHE=/var/lib/adsb-trip-journal/cache
TRIP_JOURNAL_SQLITE=/var/lib/adsb-trip-journal/trips.sqlite

WATCH_INTERVAL_SECS=600
# Production repair budget: ~10 UTC days of /flights/all at 30/slice, ~400 slack.
# CLI/laptop default (no env) is 800. install.sh does not overwrite this file.
OPENSKY_MAX_FLIGHTS_CREDITS=3600

# OAuth2 client credentials from the OpenSky account page. Prefer env; never commit secrets.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Alternative: path to credentials.json
# OPENSKY_CREDENTIALS_JSON=
