# Copy values into the environment or a local .env (gitignored). Never commit keys.
# The CLI loads `.env` from the current working directory at startup.

# Read-only mapping feed from the sibling producer.
TAIL_TO_TICKER_SQLITE=../tail-to-ticker/data/current/tail_to_ticker.sqlite

# This project's journal (created on first collect).
TRIP_JOURNAL_SQLITE=data/trips.sqlite

# Directories (optional; CLI defaults are data/ and cache/).
# TRIP_JOURNAL_DATA=data
# TRIP_JOURNAL_CACHE=cache

# ADS-B Exchange API. A feeder UUID is not an API key and will not work here.
# Community RapidAPI is live positions, non-commercial, ~10k req/month.
# Historical traces require an enterprise / traces product.
ADSBX_API_KEY=

# Optional RapidAPI (community live). If set, sent as X-RapidAPI-Key.
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=adsbexchange-com1.p.rapidapi.com

# Optional URL overrides (defaults target gateway.adsbexchange.com).
# ADSBX_LIVE_BASE=https://gateway.adsbexchange.com/api/aircraft/v2
# ADSBX_HIST_BASE=https://gateway.adsbexchange.com/api/aircraft/v2

# Optional S3 pull-data (enterprise). Probe records that the bucket is configured;
# v1 does not list or download S3 objects.
# ADSBX_S3_BUCKET=

# OpenSky Network REST (OAuth2 client credentials). Prefer env vars; never commit secrets.
# Download credentials.json from the OpenSky account page and point at it, or set id/secret.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_CREDENTIALS_JSON=credentials.json
# Catch-up budget: two UTC days of /flights/all at 30/slice is 720.
# OPENSKY_MAX_FLIGHTS_CREDITS=800

