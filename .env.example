# Copy values into the environment or a local .env (gitignored). Never commit keys.
# The CLI loads `.env` from the current working directory at startup.

# Read-only mapping feed from the sibling producer.
TAIL_TO_TICKER_SQLITE=../tail-to-ticker/data/current/tail_to_ticker.sqlite

# This project's journal (created on first collect).
TRIP_JOURNAL_SQLITE=data/trips.sqlite

# Directories (optional; CLI defaults are data/ and cache/).
# TRIP_JOURNAL_DATA=data
# TRIP_JOURNAL_CACHE=cache

# OpenSky Network REST (OAuth2 client credentials). Prefer env vars; never commit secrets.
# Download credentials.json from the OpenSky account page and point at it, or set id/secret.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_CREDENTIALS_JSON=credentials.json
# Catch-up budget: two UTC days of /flights/all at 30/slice is 720 (laptop).
# Production host env is 3600. install.sh does not overwrite an existing env file.
# OPENSKY_MAX_FLIGHTS_CREDITS=800
